[Unit]
Description=DSH loopback proxy (LAN -> 127.0.0.1:28000) for dsh-mobile admin API
After=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
Environment=LBP_PORT=28080
Environment=LBP_BACKEND_PORT=28000
ExecStart=/usr/bin/python3 /vol1/@appshare/dsh/dsh_home/loopback-proxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
